# Not needed for local development -- vite.config.ts proxies /api and /ws to
# http://localhost:8000. Set these only for a deployment where the frontend and backend
# don't share an origin. Copy this file to .env.local and fill in real values.

# Base URL for every REST call (services/api.ts). Defaults to "/api/v1" (same-origin).
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Base URL for the /ws/query WebSocket (services/streaming.ts). Defaults to deriving
# ws(s)://<current host> from window.location.
# VITE_WS_BASE_URL=wss://api.example.com