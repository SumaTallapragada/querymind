# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real credentials.

# -- Application -------------------------------------------------------
APP_NAME="Text-to-SQL Analytics Engine"
APP_ENV=development        # development | staging | production | test
# APP_DEBUG=true makes Starlette's ServerErrorMiddleware return a full Python traceback (file
# paths, SQL, driver exception internals -- e.g. asyncpg errors) as the HTTP body of *any*
# unmapped exception, completely bypassing querymind.api.app's own safe generic-500 handler,
# which only ever runs when this is false (Phase 22D-5 verification found this defaulted to
# `true` here, which `docker-compose.yml`'s `app` service reads via `env_file: .env` -- turn it
# on only for a local interactive debugging session, never for anything `docker compose up`-ed).
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Host-side port for the frontend container under `docker compose up` (docker-compose.yml's
# `frontend` service, Phase 19B) -- the container itself always listens on 8080 internally
# (frontend/Dockerfile); this only controls what port it's published as on the host.
FRONTEND_PORT=8080

# -- Logging -------------------------------------------------------------
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console          # console (human-readable, dev) | json (prod)

# -- PostgreSQL ------------------------------------------------------------
# POSTGRES_USER/PASSWORD/DB are also read directly by the postgres Docker
# image itself (see docker-compose.yml) to initialize the database.
POSTGRES_USER=querymind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=querymind
# Use "db" when running via `docker compose up`; use "localhost" when
# running the app directly on the host against a Dockerized Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- SQLAlchemy engine tuning ---------------------------------------------
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# -- LLM provider (Phase 16) ------------------------------------------------
# LLM_API_KEY defaults to empty, which the pipeline treats as "not configured"
# rather than a startup failure -- see core/config.py's own comment. Set a
# real Anthropic API key here to actually generate SQL through the API.
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_COUNT=3
LLM_BASE_URL=https://api.anthropic.com

# -- Authentication (Phase 22A) -------------------------------------------
# JWT_SECRET_KEY defaults to a clearly-labeled, insecure placeholder (see core/config.py's own
# comment) so the app still starts without one -- but set a real, random value here for any
# real deployment. A short value will trigger PyJWT's InsecureKeyLengthWarning the first time a
# token is issued; keep it at least 32 bytes for HS256.
JWT_SECRET_KEY=insecure-default-change-in-production-please-set-a-real-JWT_SECRET_KEY-env-var
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# -- Security (Phase 22D) -------------------------------------------------
# TRUST_PROXY_HEADERS gates whether X-Forwarded-For/X-Real-IP are ever read for client
# identification (audit logging, rate limiting) -- only turn this on when every path to this
# process genuinely goes through a proxy that sets them (nginx does); leave it false whenever
# the backend port might still be reachable directly, or a client could simply forge the header.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_QUERY_PER_MINUTE=30