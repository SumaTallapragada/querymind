# syntax=docker/dockerfile:1
#
# Phase 19A production image for the QueryMind backend (querymind.api.app:create_app,
# served via querymind.main:app). Distinct from the pre-existing root `Dockerfile` (which
# backs `docker-compose.yml` unchanged this phase, per the Phase 19A scope) -- this file adds
# the one thing that Dockerfile doesn't have: a container-configurable listen port, driven by
# the same `APP_PORT` environment variable `Settings.app_port` already reads (see
# `src/querymind/core/config.py` and `.env.example`), rather than inventing a second,
# confusingly-similar env var.
#
# No business logic lives here or is touched by it -- this only packages the existing,
# unmodified `src/querymind` package.

# --------------------------------------------------------------------------
# Stage 1: builder — resolve and install dependencies with uv into a venv.
# Split from the runtime stage so build tooling (uv itself, its cache) never
# ends up in the image that actually runs in production.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Install dependencies first, from the lockfile only, so this layer stays cached across code
# changes and only invalidates when pyproject.toml/uv.lock change. `--no-dev` excludes ruff,
# mypy, pytest, etc. -- this is a runtime-dependencies-only image.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY alembic.ini ./
COPY alembic ./alembic

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# --------------------------------------------------------------------------
# Stage 2: runtime — minimal image, non-root user, no build tooling, no uv.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

RUN groupadd --system app && useradd --system --gid app --create-home app

WORKDIR /app

COPY --from=builder --chown=app:app /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

# All other configuration (POSTGRES_*, LLM_*, LOG_*, ...) is supplied at `docker run`/
# `docker compose` time via -e/--env-file, exactly as it already is for local, non-Docker
# development (see .env.example) -- nothing is baked into the image, and no default is set
# here for any secret (POSTGRES_PASSWORD, LLM_API_KEY): `Settings` fails fast at startup if
# they're missing, which is the desired behavior in every environment.

USER app

EXPOSE ${APP_PORT}

# Shell form (no JSON array) so `${APP_PORT}` is expanded by the shell at container start,
# not baked in at build time -- lets `docker run -e APP_PORT=...` actually change what this
# checks and what uvicorn binds to.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; urllib.request.urlopen(sys.argv[1]).read()" "http://localhost:${APP_PORT}/api/v1/health/live" || exit 1

# `exec` replaces the shell with uvicorn so it becomes PID 1 and receives SIGTERM directly,
# instead of an intermediate `/bin/sh -c` swallowing it and forcing a slow, unclean shutdown.
# (`docker build` flags shell-form CMD with a generic "JSON args recommended" notice; `exec`
# is the standard fix for exactly the signal-handling concern that notice is about, and the
# JSON array form can't expand ${APP_PORT} at all, which is the entire point of this file.)
CMD exec uvicorn querymind.main:app --host ${APP_HOST} --port ${APP_PORT}